// Renovate's dependency updates (docs/ci.md): once a
// week, one pull request for the GitHub Actions the workflows use and one for
// the Swift packages, each checked by CI like any other, and each taking only
// releases at least three days old. Nothing runs until
// the Mend Renovate GitHub App is installed on the repository; its security
// updates read the repository's Dependabot alerts, which are turned on in its
// settings, with no Dependabot configuration of its own.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'schedule:weekly'],
  timezone: 'America/New_York',
  // The only two kinds of dependency here: the actions in .github/workflows
  // and .github/actions, and the packages Package.swift pins exactly. The
  // packages those bring are held to one version by the committed
  // Package.resolved, which Renovate never resolves (see the Swift rule below).
  enabledManagers: ['github-actions', 'swift'],
  semanticCommits: 'enabled',
  // A release is offered only once it is three days old, time for a broken or
  // compromised one to be pulled first; one without a release date waits too
  // (minimumReleaseAgeBehaviour's default). Security updates from the
  // Dependabot alerts come at once, as Renovate always raises them.
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  packageRules: [
    {
      matchManagers: ['github-actions'],
      groupName: 'GitHub Actions',
      semanticCommitType: 'ci',
    },
    {
      // The runner images (macos-26, ubuntu-latest) stay put: moving CI to a
      // new macOS image is one deliberate commit that also refreshes both
      // sets of approved images (docs/ci.md).
      matchDatasources: ['github-runners'],
      enabled: false,
    },
    {
      // Renovate moves the pin it updates in Package.resolved but resolves
      // nothing, so the file's origin hash, and any package an update needs
      // that Package.swift does not name, stay as they were, and CI's test
      // check fails until the file is resolved again on the branch (docs/ci.md
      // "Dependency updates"). The note says so on every such pull request.
      matchManagers: ['swift'],
      groupName: 'Swift packages',
      semanticCommitType: 'build',
      prBodyNotes: [
        'Before this can merge, run `scripts/check-package-resolved.sh --fix` on its branch and commit `Package.resolved`: Renovate does not resolve the package graph, and CI\'s test check fails until the file matches `Package.swift` (docs/ci.md "Dependency updates").',
      ],
    },
  ],
}
